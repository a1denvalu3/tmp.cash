# Optional frontend default. Settings stores the user's selected mint locally.
VITE_DEFAULT_MINT=http://127.0.0.1:3338

# Optional Google sign-in and Drive recovery (public Firebase Web app configuration).
# Leave all four unset to keep Google recovery disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Enable only after creating Firestore and deploying firestore.rules.
VITE_FIREBASE_SYNC_ENABLED=false
