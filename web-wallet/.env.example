# Optional frontend default. Settings stores the user's selected mint locally.
VITE_DEFAULT_MINT=http://127.0.0.1:3338
# Cloud login uses /api/cloud on this wallet's origin; no frontend OAuth secrets.
# For local development, Vite proxies that path to http://127.0.0.1:3338.
# Optional shell environment override for the proxy: WALLET_CLOUD_PROXY_TARGET.
