VITE_DEFAULT_MINT=http://127.0.0.1:3338

# Wallet-only Google sign-in and Google Drive backups.
# Public OAuth Web application client ID. Never put a client secret here.
# Register http://127.0.0.1:5173 as an Authorized JavaScript origin for local use.
VITE_GOOGLE_CLIENT_ID=

# Optional wallet-only Apple sign-in and private iCloud (CloudKit) backups.
# CloudKit web API token, not a server-to-server key or Apple .p8 signing key.
VITE_APPLE_CLOUDKIT_CONTAINER=
VITE_APPLE_CLOUDKIT_API_TOKEN=
VITE_APPLE_CLOUDKIT_ENVIRONMENT=development
