{
  "name": "tmp-cash-web-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e:production": "VITE_GOOGLE_CLIENT_ID= VITE_APPLE_CLOUDKIT_CONTAINER= VITE_APPLE_CLOUDKIT_API_TOKEN= npm run build && WALLET_E2E_PRODUCTION=1 playwright test",
    "format": "prettier --write src \"tests/**/*.ts\" packages/cashu-ts/src/tmp-cash packages/coco/tmp-cash packages/coco-indexeddb/src/tmp-cash *.ts *.json *.md",
    "format:check": "prettier --check src \"tests/**/*.ts\" packages/cashu-ts/src/tmp-cash packages/coco/tmp-cash packages/coco-indexeddb/src/tmp-cash *.ts *.json *.md",
    "test:e2e:cloud": "WALLET_E2E_CLOUD=1 playwright test tests/browser/cloud.spec.ts",
    "test:e2e:cloud:production": "VITE_GOOGLE_CLIENT_ID=browser-test-client.apps.googleusercontent.com VITE_APPLE_CLOUDKIT_CONTAINER=iCloud.tmpcash.browser-test VITE_APPLE_CLOUDKIT_API_TOKEN=browser-test-public-api-token npm run build && WALLET_E2E_CLOUD=1 WALLET_E2E_PRODUCTION=1 playwright test tests/browser/cloud.spec.ts"
  },
  "dependencies": {
    "@cashu/cashu-ts": "file:packages/cashu-ts",
    "@fontsource/dm-mono": "5.2.7",
    "@fontsource/dm-sans": "5.2.6",
    "coco-cashu-core": "file:packages/coco",
    "coco-cashu-indexeddb": "file:packages/coco-indexeddb",
    "lucide-react": "0.468.0",
    "nostr-tools": "2.26.0",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.4",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "6.4.1",
    "vitest": "3.2.4",
    "ws": "8.22.2"
  }
}
